# Copy these into Render > Environment. NEVER commit real keys to GitHub.

# --- secrets (required) ---
GEMINI_API_KEYS=<gemini key for text; several allowed, comma separated>
GEMINI_TTS_KEYS=<gemini key for read-aloud; several allowed, comma separated>
YEMOT_TOKEN=<system number>:<password>

# --- optional secrets ---
GROQ_API_KEYS=<groq key, enables "search the web" by voice>

# --- models ---
TEXT_MODEL=gemini-3.5-flash-lite
TEXT_MODEL_FALLBACK=gemini-3.1-flash-lite
# several TTS models separated by commas: next one is used when quota runs out
TTS_MODEL=gemini-3.8-flash-tts,gemini-3.1-flash-tts,gemini-3.8-flash-lite-tts,gemini-2.5-flash-tts

# --- behaviour ---
MAX_WORDS=100
HISTORY_EXT=9
# one entry per Yemot extension: p=extension number, m=mode (1 sassy, 2 smart, 3 friend), g=greeting, x=extra instruction
EXTENSIONS=[{"p":"1","m":"2","g":"הקלט את השאלה ואז הקש סולמית","x":""}]
# add "k":"1" to an extension entry to make it a typing extension (questions typed with the keys instead of recorded)
# key that sends the typed question (after it comes #); default is *
KBD_SEND=*
# files that the caller can ask to play ("play the file"): n = name, u = direct link to an mp3/mp4/wav file
MEDIA_FILES=[{"n":"שיעור יומי","u":"https://example.com/lesson.mp3"}]
# free music API (full songs): register at developer.jamendo.com and paste the client id here
JAMENDO_CLIENT_ID=<jamendo client id>
EXTRA_INSTRUCTION=
